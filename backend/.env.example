# MongoDB connection
# Local:              mongodb://127.0.0.1:27017/otaku
# Atlas (recommended): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/otaku?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/otaku

# Server
PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Machine translation provider (used by the translation layer described in the deck)
TRANSLATION_API_KEY=your_translation_api_key_here
TRANSLATION_API_URL=https://translation.googleapis.com/language/translate/v2
